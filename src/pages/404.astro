---
import Layout from '../layouts/page.astro';
---

<Layout>
    <div class="not-found">
        <p>Then, in answer to my query, <br />
        Through the net I loved so dearly, <br />
        Came its answer, dark and dreary: 
        </p>
        <h1>Quoth the server, 404</h1>
        <p>
            <a href="/">&larr; back</a>"
        </p>
    </div>
</Layout>

<style>
    .not-found {
	margin: 0 auto;
	max-width: 500px;
	text-align: center;
}

.not-found h1 {
	font-size: 2rem;
}

.not-found img {
	display: block;
	margin: 1rem 0 0;
	width: 100%;
}

</style>